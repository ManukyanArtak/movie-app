# TMDb API Configuration
# Get your access token from: https://www.themoviedb.org/settings/api

# Required: Your TMDb API Access Token (Bearer token)
VITE_TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# Optional: TMDb API Base URL (defaults to https://api.themoviedb.org/3 if not set)
VITE_API_BASE_URL=https://api.themoviedb.org/3

# Optional: Image Base URL for movie posters (defaults to https://image.tmdb.org/t/p/w500 if not set)
VITE_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Optional: Backdrop Base URL for movie backgrounds (defaults to https://image.tmdb.org/t/p/original if not set)
VITE_BACKDROP_BASE_URL=https://image.tmdb.org/t/p/original
